# Copy to .env for local development. On FluxCloud, set these as app environment variables.

# Port the server listens on (must match the FluxCloud app port / Orbit APP_PORT).
PORT=8080

# Price: FLUX/USD from the Flux explorer (tried in order), other currencies via Frankfurter (ECB daily rates).
EXPLORER_URLS=https://explorer.runonflux.io,https://explorer.app.runonflux.io
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Optional CoinGecko Demo API key, used only when the explorer price is unavailable.
# Server-side only; never sent to the browser. Variable names are case-sensitive.
COINGECKO_API_KEY=

# Minutes between price refreshes per instance.
PRICE_REFRESH_MINUTES=20

# Flux API gateway.
FLUX_API_BASE_URL=https://api.runonflux.io

# Seconds between network data refreshes (height, node counts).
NETWORK_REFRESH_SECONDS=90

# Max simultaneous requests to the Flux API per instance (FluxOS caps daemon RPC at 5).
FLUX_MAX_CONCURRENCY=2

# Node lookups allowed per visitor IP per minute.
LOOKUP_RATE_PER_MINUTE=10

# Trust X-Forwarded-For from the FluxCloud proxy for per-visitor rate limits.
TRUST_PROXY=true
